# App Settings
PROJECT_NAME="Hệ Thống Salon Tóc AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database (MySQL or SQLite fallback)
# MySQL Format: mysql+pymysql://root:password@localhost:3306/salon_db
# SQLite Format: sqlite:///./salon.db
DATABASE_URL="sqlite:///./salon.db"

# JWT Security
JWT_SECRET="super-secret-salon-jwt-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
AI_TEMPERATURE=0.2

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
