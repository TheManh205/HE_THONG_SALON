# ==========================================
# CẤU HÌNH HỆ THỐNG SALON TÓC TÍCH HỢP AI
# ==========================================

# 1. Backend Settings
PROJECT_NAME="THEMANH Luxury Salon Management & AI Engine"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# 2. Database Connection
# Mặc định sử dụng SQLite để chạy ngay không cần cài đặt thêm.
# Để dùng MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Ví dụ MySQL: mysql+pymysql://root:password123@localhost:3306/salon_db
DATABASE_URL="sqlite:///./salon.db"

# 3. Bảo Mật JWT (JSON Web Token)
# LƯU Ý: Phải thay đổi JWT_SECRET bằng biến môi trường khi triển khai production!
JWT_SECRET="dev-secret-key-only"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 4. Google Gemini API (AI Service Layer)
# Lấy API Key miễn phí tại https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
GEMINI_MODEL="gemini-2.5-flash"
AI_TEMPERATURE=0.2

# 5. CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
